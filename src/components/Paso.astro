---
// Un paso numerado con su lista de casillas.
import type { PasoChecklist } from "../data/etapas";
import Item from "./Item.astro";

interface Props {
  paso: PasoChecklist;
  numero: number;
}
const { paso, numero } = Astro.props;
const marca = paso.n ?? String(numero).padStart(2, "0"); // hora (6:00) o número (02)
---

<section class="paso" data-paso>
  <h2>
    <span class="n">{marca}</span>
    <span>{paso.titulo}</span>
    <span class="cnt" data-paso-cuenta>0/{paso.items.length}</span>
  </h2>
  {paso.nota && <p class="nota">{paso.nota}</p>}
  <ul>
    {paso.items.map((it) => <Item item={it} />)}
  </ul>
</section>

<style>
  .paso { display: grid; gap: 8px; }
  h2 {
    display: flex; align-items: baseline; gap: 10px; margin: 0;
    font-family: var(--f-display); font-weight: 700; font-size: 1.3rem;
    text-transform: uppercase; letter-spacing: 0.02em; line-height: 1.15; text-wrap: balance;
  }
  .n { font-family: var(--f-mono); font-size: 0.85rem; color: var(--accent); font-weight: 500; flex: none; }
  .cnt { margin-left: auto; font-family: var(--f-mono); font-size: 0.8rem; color: var(--muted); font-weight: 500; flex: none; }
  .paso.completo .cnt { color: var(--ok); }
  .nota { margin: 0; font-size: 0.9rem; color: var(--muted); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
</style>
