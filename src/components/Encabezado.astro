---
// Cabecera fija: título, barra de progreso global y pestañas de etapas.
// Los contadores salen en "0/N" desde el servidor; el script del navegador
// los actualiza con lo que el usuario ya marcó.
import { ETAPAS, esReferencia } from "../data/etapas";

const totalItems = (id: string) =>
  ETAPAS.find((e) => e.id === id)!.pasos.reduce((n, p) => n + (esReferencia(p) ? 0 : p.items.length), 0);
const total = ETAPAS.reduce((n, e) => n + totalItems(e.id), 0);
---

<header>
  <div class="wrap">
    <div class="top">
      <h1>Mi Mesa · Presidente</h1>
      <span class="pct" data-progreso-texto>0 / {total}</span>
    </div>
    <div class="bar"><i data-progreso-barra></i></div>
    <nav role="tablist">
      {ETAPAS.map((e, i) => (
        <button role="tab" type="button" data-tab={e.id} aria-selected={i === 0 ? "true" : "false"}>
          <b>{e.nombre}</b>
          <small data-tab-cuenta={e.id}>0/{totalItems(e.id)}</small>
        </button>
      ))}
      <button role="tab" type="button" data-tab="datos" aria-selected="false">
        <b>Números</b><small>actas</small>
      </button>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .wrap { max-width: 720px; margin: 0 auto; padding: 12px 16px 0; }
  .top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  h1 {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: 0.01em;
    margin: 0;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .pct { font-family: var(--f-mono); font-size: 0.9rem; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .bar { height: 6px; background: var(--surface-2); border-radius: 3px; margin-top: 10px; overflow: hidden; }
  .bar > i { display: block; height: 100%; width: 0; background: var(--accent); transition: width 0.3s; }
  nav { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; margin-top: 10px; }
  nav button {
    background: none;
    border: 0;
    border-bottom: 3px solid transparent;
    padding: 6px 2px 8px;
    cursor: pointer;
    text-align: center;
    min-width: 0;
  }
  nav b { display: block; font-family: var(--f-display); font-size: 1.05rem; letter-spacing: 0.03em; text-transform: uppercase; line-height: 1.1; }
  nav small { display: block; font-family: var(--f-mono); font-size: 0.7rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  nav button[aria-selected="true"] { border-bottom-color: var(--accent); }
  nav button[aria-selected="true"] b { color: var(--accent); }
  @media (max-width: 420px) {
    nav b { font-size: 0.92rem; }
    h1 { font-size: 1.35rem; }
  }
</style>
